{
  // VS Code task schema version, unrelated to the installed CMake version.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C++: configure",
      // Run the executable directly; args are individual command-line arguments.
      "type": "process",
      "command": "/opt/homebrew/bin/cmake",
      // Find dependencies and generate build rules and compile_commands.json.
      "args": ["--preset", "debug-asan"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "C++: build",
      "type": "process",
      "command": "/opt/homebrew/bin/cmake",
      // Compile the debug preset; --parallel allows concurrent build jobs.
      "args": ["--build", "--preset", "debug-asan", "--parallel"],
      "options": { "cwd": "${workspaceFolder}" },
      // Configure before building so that the dependency paths are available.
      "dependsOn": "C++: configure",
      // Make this the default build task invoked by Cmd+Shift+B on macOS.
      "group": { "kind": "build", "isDefault": true },
      // Recognize GCC/Clang-style compiler messages in the Problems panel.
      "problemMatcher": "$gcc"
    },
    {
      "label": "C++: check current file",
      "type": "process",
      "command": "/opt/homebrew/opt/llvm/bin/clangd",
      "args": [
        // ${file} expands to the full path of the active editor's source file.
        "--check=${file}",
        "--compile-commands-dir=${workspaceFolder}/build",
        "--clang-tidy",
        "--enable-config"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "C++: configure",
      // Diagnostics appear in the terminal; this task defines no output parser.
      "problemMatcher": []
    },
    {
      "label": "C++: format current file",
      "type": "process",
      "command": "/opt/homebrew/bin/clang-format",
      // IMPORTANT: -i rewrites the active file in place. Without -i the tool
      // prints formatted text to stdout instead of changing the source file.
      "args": ["--style=file", "-i", "${file}"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
