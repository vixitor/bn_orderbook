---
# Static analysis rules, used by clang-tidy and by clangd's --clang-tidy mode.
# The YAML >- syntax folds the following lines into one comma-separated string.
# Patterns are applied in order: disable everything, enable selected groups,
# then disable two individual checks. Tools only run checks they support.
# clang-analyzer-* finds selected logic defects; bugprone-* flags risky patterns;
# google-* checks parts of Google's style; performance-* suggests improvements.
# The two modernize checks encourage nullptr and explicit override annotations.
Checks: >-
  -*,
  clang-analyzer-*,
  bugprone-*,
  google-*,
  performance-*,
  modernize-use-nullptr,
  modernize-use-override,
  readability-identifier-naming,
  -bugprone-easily-swappable-parameters,
  -google-readability-todo
# Disable the parameter-swapping heuristic to reduce noisy reports.
# Disable the old TODO check because it uses an older Google TODO convention.
# An empty value does not promote any clang-tidy warnings to errors.
WarningsAsErrors: ''
# Allow matching header diagnostics, but do not enable system-header reporting.
# Headers can still be parsed even when their diagnostics are not displayed.
HeaderFilterRegex: '.*'
SystemHeaders: false
# When a fix requires formatting, use the project's .clang-format file.
FormatStyle: file
CheckOptions:
  # Namespaces: boost_adapter. Types: OrderBook, Trade, ConnectionState.
  readability-identifier-naming.NamespaceCase: lower_case
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  # A `using` alias is a type name too: Tcp, not tcp.
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.TypedefCase: CamelCase
  # Functions and methods: Connect, ReadMessage. C++ requires the name main.
  readability-identifier-naming.FunctionCase: CamelCase
  readability-identifier-naming.FunctionIgnoredRegexp: '^main$'
  readability-identifier-naming.MethodCase: CamelCase
  # Permit STL-style accessors such as size(). This broad exception cannot tell
  # whether a lowercase method is actually an accessor; review is still needed.
  readability-identifier-naming.MethodIgnoredRegexp: '^[a-z][a-z0-9_]*$'
  # Variables, parameters, and ordinary members use names such as trade_count.
  readability-identifier-naming.VariableCase: lower_case
  readability-identifier-naming.ParameterCase: lower_case
  readability-identifier-naming.MemberCase: lower_case
  # Class data members add a trailing underscore: trade_count_.
  readability-identifier-naming.ClassMemberCase: lower_case
  readability-identifier-naming.ClassMemberSuffix: '_'
  # Constants in these categories use a k prefix: kMaxDepth.
  readability-identifier-naming.GlobalConstantCase: CamelCase
  readability-identifier-naming.GlobalConstantPrefix: k
  readability-identifier-naming.StaticConstantCase: CamelCase
  readability-identifier-naming.StaticConstantPrefix: k
  readability-identifier-naming.ClassConstantCase: CamelCase
  readability-identifier-naming.ClassConstantPrefix: k
  readability-identifier-naming.EnumConstantCase: CamelCase
  readability-identifier-naming.EnumConstantPrefix: k
  # Preprocessor macros use names such as ENABLE_TRACING.
  readability-identifier-naming.MacroDefinitionCase: UPPER_CASE
# These checks cover only part of the style guide and do not rewrite names
# automatically. Applying an editor quick fix is a separate action.
