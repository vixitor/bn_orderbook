# clangd is the language server behind completion, navigation, and diagnostics.
CompileFlags:
  # Relative to this file: read build/compile_commands.json generated by CMake.
  # That database supplies C++20, SDK flags, and Boost/OpenSSL include paths.
  CompilationDatabase: build
Diagnostics:
  ClangTidy:
    # Run only checks known to be fast, keeping interactive diagnostics responsive.
    # Check selection and naming options are defined separately in .clang-tidy.
    # This mode is not a complete audit of every enabled clang-tidy check.
    FastCheckFilter: Strict
